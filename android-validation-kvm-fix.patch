       # --------------------------------------------------
-      # 9. Android emulator tests
+      # 9. Enable and verify KVM before starting the emulator
+      # --------------------------------------------------
+      - name: Enable KVM access
+        shell: bash
+        run: |
+          set -euo pipefail
+
+          if [ ! -e /dev/kvm ]; then
+            echo "::error::KVM device /dev/kvm is not available on this runner."
+            exit 1
+          fi
+
+          echo 'KERNEL=="kvm", GROUP="kvm", MODE="0666", OPTIONS+="static_node=kvm"' | sudo tee /etc/udev/rules.d/99-kvm4all.rules
+          sudo udevadm control --reload-rules
+          sudo udevadm trigger --name-match=kvm
+
+          if [ ! -r /dev/kvm ] || [ ! -w /dev/kvm ]; then
+            echo "::error::The runner does not have read/write access to /dev/kvm."
+            ls -l /dev/kvm || true
+            id
+            exit 1
+          fi
+
+          echo "KVM device and permissions:"
+          ls -l /dev/kvm
+          id
+          echo "KVM access: PASS"
+
